#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
  echo "Usage: scripts/install-apk APK" >&2
  exit 2
fi

readonly APK="$(realpath "$1")"
if [[ ! -f "${APK}" ]]; then
  echo "APK does not exist: ${APK}" >&2
  exit 1
fi

adb start-server
if [[ "$(adb devices | awk 'NR > 1 && $2 == "device" { count++ } END { print count + 0 }')" != "1" ]]; then
  echo "Exactly one authorized Android device must be connected." >&2
  adb devices -l >&2
  exit 1
fi

# -r (reinstall, keeping data) rather than --replace: Android's on-device package manager
# shell command rejects the long form with "Unknown option --replace".
adb install -r "${APK}"
