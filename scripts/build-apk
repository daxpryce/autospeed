#!/usr/bin/env bash
set -euo pipefail

# Builds one Autospeed variant and copies its APK to dist/ under a stable, descriptive name, so
# a locally built artifact never has to be dug out of app/build/outputs/apk/<flavor>/<type>/.
#
# Run inside the devcontainer, e.g.:
#   ./scripts/container-run ./scripts/build-apk
#   ./scripts/container-run ./scripts/build-apk publicFrameworkDebug
#
# Personal variants additionally require AUTOSPEED_PERSONAL_USE_ACK (design section 2.1);
# devcontainer.json forwards it from the host environment.

readonly ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly DIST_DIR="${ROOT}/dist"
readonly VARIANT="${1:-personalFrameworkDebug}"

case "${VARIANT}" in
  *Debug) BUILD_TYPE="debug" ;;
  *Release) BUILD_TYPE="release" ;;
  *)
    echo "Variant must end in Debug or Release, e.g. personalFrameworkDebug: ${VARIANT}" >&2
    exit 2
    ;;
esac

# personalFrameworkDebug -> personalFramework
readonly FLAVOR="${VARIANT%"${BUILD_TYPE^}"}"
readonly VARIANT_DIR="${ROOT}/app/build/outputs/apk/${FLAVOR}/${BUILD_TYPE}"

cd "${ROOT}"
./gradlew "assemble${VARIANT^}"

apk="$(find "${VARIANT_DIR}" -maxdepth 1 -type f -name '*.apk' -print -quit 2>/dev/null || true)"
if [[ -z "${apk}" ]]; then
  echo "No APK was produced in ${VARIANT_DIR}." >&2
  exit 1
fi

# A release build with no signing configuration still succeeds: AGP simply emits
# `*-release-unsigned.apk`, which this script would then copy to a destination name that gives no
# hint it cannot be installed. Attempting to install it fails much later with
# INSTALL_PARSE_FAILED_NO_CERTIFICATES, so confirm the signature here rather than trusting that a
# successful build implies a usable artifact.
if [[ "${BUILD_TYPE}" == "release" ]]; then
  apksigner="$(find "${ANDROID_HOME:-/opt/android-sdk}/build-tools" -type f -name apksigner 2>/dev/null | sort | tail -1)"
  if [[ -z "${apksigner}" ]]; then
    echo "Cannot locate apksigner, so ${apk} cannot be confirmed as signed." >&2
    exit 1
  fi
  if ! "${apksigner}" verify "${apk}" >/dev/null 2>&1; then
    echo "${apk} is not signed and cannot be installed." >&2
    echo "Export AUTOSPEED_SIGNING_STORE_FILE, AUTOSPEED_SIGNING_STORE_PASSWORD," >&2
    echo "AUTOSPEED_SIGNING_KEY_ALIAS and AUTOSPEED_SIGNING_KEY_PASSWORD on the host" >&2
    echo "(devcontainer.json forwards them into the container) and build again." >&2
    echo "See docs/releases.md for the local release-build recipe." >&2
    exit 1
  fi
fi

mkdir -p "${DIST_DIR}"
readonly DEST="${DIST_DIR}/autospeed-${FLAVOR}-${BUILD_TYPE}.apk"
install -m 0644 "${apk}" "${DEST}"

echo
echo "APK: ${DEST}"
echo "     (on the host: ${DEST/#${ROOT}/.})"
