<?xml version="1.0" encoding="utf-8"?>
<!-- Media-companion overlay (design section 3.6): speed only, drawn as a speed-limit sign. The
     entire surface is the tap-to-return target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <io.pryce.android.autospeed.ui.SpeedSignView
        android:id="@+id/overlay_speed_display"
        android:layout_width="@dimen/overlay_sign_size"
        android:layout_height="@dimen/overlay_sign_size" />

</FrameLayout>
