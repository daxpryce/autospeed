<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/content_container"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_orientation" />
        <Spinner
            android:id="@+id/orientation_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_primary_unit"
            android:paddingTop="16dp" />
        <Spinner
            android:id="@+id/primary_unit_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_secondary_visible" />
            <Switch
                android:thumbTint="@color/switch_thumb_tint"
                android:trackTint="@color/switch_track_tint"
                android:id="@+id/secondary_visible_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_appearance"
            android:paddingTop="16dp" />
        <Spinner
            android:id="@+id/appearance_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_background"
            android:paddingTop="16dp" />
        <Spinner
            android:id="@+id/background_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Only the control belonging to the selected background mode is shown, so the screen
             never offers a choice that has no effect. -->
        <Button
            android:id="@+id/background_color_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:visibility="gone"
            android:text="@string/settings_background_color" />

        <Button
            android:id="@+id/background_image_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:visibility="gone"
            android:text="@string/settings_background_image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_notification_suppression" />
            <Switch
                android:thumbTint="@color/switch_thumb_tint"
                android:trackTint="@color/switch_track_tint"
                android:id="@+id/notification_suppression_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/play_fallback_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_play_fallback" />
            <Switch
                android:thumbTint="@color/switch_thumb_tint"
                android:trackTint="@color/switch_track_tint"
                android:id="@+id/play_fallback_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_map_app"
            android:paddingTop="16dp" />
        <Button
            android:id="@+id/map_app_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_none_selected" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_media_app"
            android:paddingTop="16dp" />
        <Button
            android:id="@+id/media_app_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_none_selected" />

        <!--
            Re-entry point for the up-front access setup, so permissions skipped on first run or
            revoked later can be granted here rather than only via a mid-drive prompt.
        -->
        <Button
            android:id="@+id/review_access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/action_review_access" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_about_heading"
            android:textStyle="bold"
            android:paddingTop="24dp" />

        <!--
            The note is deliberately a short pointer rather than the license text: the binding copy
            lives in LICENSE at the repository root, and restating it here would create a second
            copy to keep in sync.
        -->
        <TextView
            android:id="@+id/license_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="12sp"
            android:text="@string/settings_license_note" />

        <Button
            android:id="@+id/about_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/action_about" />

    </LinearLayout>

</ScrollView>
