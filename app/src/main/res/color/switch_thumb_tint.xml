<?xml version="1.0" encoding="utf-8"?>
<!-- An enabled toggle must read as clearly "on" rather than a slightly darker monochrome. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/day_accent" />
    <item android:color="@color/switch_off" />
</selector>
