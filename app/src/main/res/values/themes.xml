<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The main display's window must be created translucent and wallpaper-showing. Both of
        these are window *creation* attributes: a window whose surface is created opaque stays
        opaque, so setting FLAG_SHOW_WALLPAPER or a transparent background drawable at runtime
        has no effect. It also leaves the surface uncleared between frames, which previously
        stranded the first frame's background colour on screen and let stale speed text pile up
        underneath the current reading.

        With a translucent surface, the system composites the wallpaper behind the window and
        clears the surface each frame. The solid-colour and image background modes simply paint
        an opaque background on the content root, which covers the wallpaper entirely.
    -->
    <style name="Theme.Autospeed" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
        Settings and access setup are dense text screens, so they keep an ordinary opaque window
        rather than rendering over the wallpaper.
    -->
    <style name="Theme.Autospeed.Content" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/day_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
        Dialogs are separate windows, so they take their colours from the theme they are
        constructed with rather than from the activity's applied palette. Without these they stay
        on the device theme and can appear light while the rest of Autospeed is in night mode.
    -->
    <style name="Theme.Autospeed.Dialog.Day" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorBackground">@color/day_background</item>
        <item name="android:textColorPrimary">@color/day_on_background</item>
        <item name="android:textColorSecondary">@color/day_on_background</item>
        <item name="android:colorAccent">@color/day_accent</item>
    </style>

    <style name="Theme.Autospeed.Dialog.Night" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorBackground">@color/night_background</item>
        <item name="android:textColorPrimary">@color/night_on_background</item>
        <item name="android:textColorSecondary">@color/night_on_background</item>
        <item name="android:colorAccent">@color/night_accent</item>
    </style>
</resources>
