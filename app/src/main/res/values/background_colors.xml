    <color name="background_choice_charcoal">#FF1C1C1E</color>
    <color name="background_choice_slate">#FF2F3A45</color>
    <color name="background_choice_navy">#FF0B1F3A</color>
    <color name="background_choice_forest">#FF10291B</color>
    <color name="background_choice_maroon">#FF2B0F14</color>
    <color name="background_choice_sand">#FFE8DCC0</color>
    <color name="background_choice_white">#FFFFFFFF</color>
</resources>
