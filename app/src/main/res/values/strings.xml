    <string name="settings_about_heading">About</string>
    <string name="settings_license_note">Autospeed is released under the MIT License. The full text ships with the source repository.</string>
    <string name="action_about">About Autospeed</string>
    <string name="about_dialog_title">About Autospeed</string>
    <string name="about_dialog_body">Autospeed was written by Dax Pryce together with a large language model, for his own personal use in his own vehicle.\n\nIt is shared as-is under the MIT License, with no warranty of any kind. Anyone else who installs or runs it does so entirely at their own risk and assumes all liability and responsibility for that choice.\n\nAutospeed is not a certified instrument. It estimates speed from satellite positioning, which can be delayed, degraded, or wrong. Always trust your vehicle\u2019s own instrument cluster over this app, and keep your attention on the road.</string>
    <string name="action_close">Close</string>

    <string name="access_location_title">Precise location</string>
    <string name="access_location_explanation">Used to calculate your current speed. Speed is computed on the device and never leaves it; Autospeed has no internet permission and stores no location history.</string>
    <string name="access_notifications_title">Notifications</string>
    <string name="access_notifications_explanation">Android requires a visible notification while overlay mode keeps your speed on screen over another app. Autospeed posts nothing else.</string>
    <string name="access_overlay_title">Display over other apps</string>
    <string name="access_overlay_explanation">Lets Autospeed keep your speed visible on top of your map or media app after you launch it.</string>
    <string name="access_notification_listener_title">Notification access</string>
    <string name="access_notification_listener_explanation">Used only to find and control the media session that is currently playing, so the play, next, and previous buttons work. Autospeed does not read, store, or transmit your notifications.</string>
    <string name="access_notification_policy_title">Do Not Disturb access</string>
    <string name="access_notification_policy_explanation">Lets Autospeed silence notification interruptions while it is on screen. Notifications still arrive in your drawer; only their sounds, vibration, and pop-ups are suppressed.</string>
