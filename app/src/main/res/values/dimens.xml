<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base content padding applied on top of system-bar and display-cutout insets so text
         never touches a screen edge (design sections 3.2 and 7). -->
    <dimen name="content_padding">16dp</dimen>

    <!-- Width of the landscape media transport column: a 56dp control plus its 8dp margins. The
         speed column reserves exactly this much as an end margin, which avoids weighting the
         landscape root and therefore avoids a nested layout weight. -->
    <dimen name="media_bar_width">72dp</dimen>

    <!-- Overlay sizing (design section 3.6): the whole overlay stays within roughly one inch
         square (160dp is one inch), so it never covers a meaningful part of the map or media
         application underneath it. -->
    <dimen name="overlay_sign_size">80dp</dimen>
    <dimen name="overlay_button_size">36dp</dimen>
    <dimen name="overlay_screen_margin">8dp</dimen>

    <!-- Colour swatch rows are tall enough to be an easy target and to show the colour itself. -->
    <dimen name="color_swatch_height">56dp</dimen>
</resources>
